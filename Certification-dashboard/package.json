{
  "name": "sim-halal-fatayat-nu-mersi",
  "version": "2.0.0",
  "description": "Portal Monitoring & Kesiapan Sertifikasi Halal BPJPH - Pimpinan Ranting Fatayat NU Desa Mersi (Modern Stack: React + Vite + Tailwind & Golang Backend)",
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"cyan.bold,magenta.bold\" --kill-others \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:go": "concurrently -n \"BACKEND,FRONTEND\" -c \"cyan.bold,magenta.bold\" --kill-others \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:py": "concurrently -n \"BACKEND,FRONTEND\" -c \"yellow.bold,magenta.bold\" --kill-others \"npm run dev:backend-py\" \"npm run dev:frontend\"",
    "dev:sh": "./dev.sh",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && go run main.go",
    "dev:backend-py": "cd backend-py && python3 -m uvicorn main:app --reload --port 8080",
    "build": "cd frontend && npm run build && cd ../backend && go build -o server main.go",
    "install:all": "npm install && cd frontend && npm install",
    "postinstall": "cd frontend && npm install"
  },
  "keywords": [
    "halal",
    "bpjph",
    "fatayat-nu",
    "react",
    "vite",
    "tailwind",
    "golang",
    "fastapi",
    "purwokerto",
    "sdum-2026"
  ],
  "author": "Program Sains Data untuk Masyarakat (SDUM) 2026",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
